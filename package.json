    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.13.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/cookie-parser": "^1.4.8",
